[
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[CACHE]/cipd_packages",
      "-ensure-file",
      "codecs/infra/android-ndk latest\ncodecs/infra/mips-img-linux-gnu latest\ncodecs/infra/mips-mti-linux-gnu latest",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "name": "ensure_installed",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"codecs/infra/android-ndk\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }, @@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"codecs/infra/mips-img-linux-gnu\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }, @@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"codecs/infra/mips-mti-linux-gnu\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "Found [CACHE]/cipd_packages/android-ndk installed"
  },
  {
    "cmd": [],
    "name": "Found [CACHE]/cipd_packages/mips-img-linux-gnu/bin installed"
  },
  {
    "cmd": [],
    "name": "Found [CACHE]/cipd_packages/mips-mti-linux-gnu/bin installed"
  },
  {
    "name": "$result"
  }
]